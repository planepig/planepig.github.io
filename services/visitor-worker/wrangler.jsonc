{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "junyi-visitor-statistics",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "routes": [{ "pattern": "stats.planepig.top", "custom_domain": true }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "STATS", "id": "cfd888caba164156889a3e68e6e3f953" }]
}
